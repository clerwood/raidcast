{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows x64 (MSVC)",
      "binaryDir": "${sourceDir}/build/windows",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;RelWithDebInfo"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "common-only",
      "displayName": "common/ and tests only (any platform)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/common-only",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RAIDCAST_BUILD_APPS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "common-only",
      "configurePreset": "common-only"
    }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "common-only",
      "configurePreset": "common-only",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
